# Live scanner running directly on the host, with PostgreSQL and Redis in Docker.
APP_ENV=development
APP_MODE=live
MOCK_MODE=false

# Use localhost here. The Docker-only service names "postgres" and "redis"
# resolve only from another Compose container.
DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5432/scanner
REDIS_URL=redis://localhost:6379/0

ENABLED_SPORTS=soccer
ENABLED_BOOKMAKERS=bookmaker_eu,stake,cloudbet,betus,pinnacle,coolbet
ENABLED_MARKET_TYPES=moneyline,total,spread,btts

SPORTS_ODDS_MODE=live
SPORTS_ODDS_API_KEY=
SPORTS_ODDS_BASE_URL=https://api.oddspapi.io/v4

KALSHI_MODE=disabled
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Public read-only market data does not require a Polymarket key.
POLYMARKET_MODE=live
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com

CLIENT_TIMEZONE=America/New_York
PRICE_POLL_INTERVAL_SECONDS=30
EVENT_MATCH_KICKOFF_TOLERANCE_MINUTES=15
EVENT_MATCH_FUZZY_MIN_SCORE=80
EVENT_MATCH_AMBIGUITY_MARGIN=5
LIVE_DRY_RUN=true
ALERTS_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
