# Runtime
APP_ENV=development
MOCK_MODE=true

# Infrastructure (all timestamps are stored in UTC)
DATABASE_URL=postgresql+asyncpg://scanner:scanner@postgres:5432/scanner
REDIS_URL=redis://redis:6379/0

# Live provider credentials (required only when MOCK_MODE=false)
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://v5.oddspapi.io/en
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Optional Telegram delivery; mock sender is used in mock mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner policy
ENABLED_BOOKMAKERS=bookmaker_eu,stake,cloudbet,betus,pinnacle,coolbet
CLIENT_TIMEZONE=America/New_York
ENABLED_MARKET_TYPES=moneyline,total,spread,btts
MAX_BID_ASK_SPREAD_CENTS=5
DEPTH_WINDOW_FROM_MIDPOINT_CENTS=3
MIN_DEPTH_WITHIN_WINDOW_USD=2000
MIN_TRAILING_24H_VOLUME_USD=5000
EDGE_THRESHOLD_PP=3.0
MAX_PREDICTION_PRICE_AGE_SECONDS=20
MAX_SPORTSBOOK_PRICE_AGE_SECONDS=60
MIN_KALSHI_ASK_SIZE=100
MIN_POLYMARKET_ASK_SIZE=100
MIN_MINUTES_BEFORE_KICKOFF=10
MAX_HOURS_BEFORE_KICKOFF=72
ALERT_COOLDOWN_MINUTES=10
REALERT_EDGE_INCREASE_PP=1.0
ODDSPAPI_POLL_INTERVAL_SECONDS=30
