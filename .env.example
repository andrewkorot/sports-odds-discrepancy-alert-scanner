# Runtime
APP_ENV=production
DASHBOARD_UI=simple
APP_MODE=live
MOCK_MODE=false

# Infrastructure (all timestamps are stored in UTC)
DATABASE_URL=postgresql+asyncpg://scanner:scanner@postgres:5432/scanner
REDIS_URL=redis://redis:6379/0

# Live provider credentials (required only when MOCK_MODE=false)
SPORTS_ODDS_API_KEY=
SPORTS_ODDS_BASE_URL=https://api.oddspapi.io/v4
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_MODE=mock
KALSHI_REST_ENABLED=true
KALSHI_WS_ENABLED=false
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
POLYMARKET_MODE=mock
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_WS_ENABLED=false
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
SPORTS_ODDS_MODE=mock

# Optional Telegram delivery; mock sender is used in mock mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_DRY_RUN=true
ALERTS_ENABLED=false
TELEGRAM_ENABLED=false

# Scanner policy
ENABLED_SPORTS=soccer
ENABLED_BOOKMAKERS=bookmaker.eu,stake,cloudbet,betus,pinnacle,coolbet
CLIENT_TIMEZONE=America/New_York
ENABLED_MARKET_TYPES=moneyline,total,spread,btts
MAX_BID_ASK_SPREAD_CENTS=5
DEPTH_WINDOW_FROM_MIDPOINT_CENTS=3
MIN_DEPTH_WITHIN_WINDOW_USD=2000
MIN_TRAILING_24H_VOLUME_USD=5000
EDGE_THRESHOLD_PP=3.0
MAX_PREDICTION_PRICE_AGE_SECONDS=20
MAX_SPORTSBOOK_PRICE_AGE_SECONDS=60
MIN_KALSHI_ASK_SIZE=100
MIN_POLYMARKET_ASK_SIZE=100
MIN_MINUTES_BEFORE_KICKOFF=10
MAX_HOURS_BEFORE_KICKOFF=72
ALERT_COOLDOWN_MINUTES=10
REALERT_EDGE_INCREASE_PP=1.0
PRICE_POLL_INTERVAL_SECONDS=60
PROVIDER_REQUEST_CONCURRENCY=8
EVENT_MATCH_KICKOFF_TOLERANCE_MINUTES=15
EVENT_MATCH_FUZZY_MIN_SCORE=80
EVENT_MATCH_AMBIGUITY_MARGIN=5
ALERT_DEDUPE_TTL_SECONDS=900
ALERT_EDGE_CHANGE_THRESHOLD=0.01
