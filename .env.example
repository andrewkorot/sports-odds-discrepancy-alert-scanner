APP_ENV=production
DASHBOARD_UI=simple
APP_MODE=live
MOCK_MODE=false

KALSHI_MODE=live
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
KALSHI_PRIVATE_KEY_HOST_PATH=./kalshi_private_key.pem

POLYMARKET_MODE=live
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com

SPORTS_ODDS_MODE=live
ENABLED_SPORTS=soccer
SPORTS_ODDS_BASE_URL=https://api.oddspapi.io/v4
SPORTS_ODDS_API_KEY=
ODDSPAPI_DISCOVERY_DUMP_PATH=runtime/oddspapi_discovered_events.json

# Explicit scanner policy settings. These previously fell back to defaults in
# app/core/config.py; keeping them here makes the active local policy visible.
ENABLED_BOOKMAKERS=bookmaker.eu,stake,cloudbet,pinnacle,coolbet
ENABLED_MARKET_TYPES=moneyline,total,spread,btts
CLIENT_TIMEZONE=America/Los_Angeles

MIN_KALSHI_ASK_SIZE=100
MIN_POLYMARKET_ASK_SIZE=100
DISCOVERY_CALENDAR_DAYS=1
ALERT_COOLDOWN_MINUTES=10
REALERT_EDGE_INCREASE_PP=1.0
MIN_MINUTES_BEFORE_KICKOFF=5
EVENT_MATCH_KICKOFF_TOLERANCE_MINUTES=15
MAX_PREDICTION_PRICE_AGE_SECONDS=20
MAX_SPORTSBOOK_PRICE_AGE_SECONDS=60
MAX_BID_ASK_SPREAD_CENTS=5
DEPTH_WINDOW_FROM_MIDPOINT_CENTS=3
MIN_DEPTH_WITHIN_WINDOW_USD=2000
MIN_TRAILING_24H_VOLUME_USD=5000
EDGE_THRESHOLD_PP=3.0

# scan rate and alert deduplication
PRICE_POLL_INTERVAL_SECONDS=60
PROVIDER_REQUEST_CONCURRENCY=4

EVENT_MATCH_FUZZY_MIN_SCORE=80
EVENT_MATCH_AMBIGUITY_MARGIN=5

LIVE_DRY_RUN=false
ALERTS_ENABLED=true
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=postgresql+asyncpg://scanner:scanner@postgres:5432/scanner
REDIS_URL=redis://redis:6379/0
